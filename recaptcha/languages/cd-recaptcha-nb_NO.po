msgstr "Feil"

#: src/Admin/Settings.php:1051
msgid "Warning"
msgstr "Advarsel"

#: src/Admin/Settings.php:1052
msgid "Notice"
msgstr "Merknad"

#: src/Admin/Settings.php:1053
msgid "Info"
msgstr "Info"

#: src/Admin/Settings.php:1054
msgid "Debug"
msgstr "Debug"

#: src/Admin/Settings.php:1056
msgid ""
"The minimum required severity level that messages must have for them to be "
"written to the log."
msgstr ""
"Det minste påkrevde alvorlighetsnivået som meldinger må ha for at de skal "
"skrives til loggen."

#: src/Admin/Settings.php:1065
msgid "Specify your own directory where the log files will be stored."
msgstr "Spesifiser din egen katalog hvor loggfilene vil bli lagret."

#: src/Admin/Settings.php:1066
msgid "Using an absolute path is recommended."
msgstr "Å bruke en absolutt bane er anbefalt."

#: src/Admin/Settings.php:1067
