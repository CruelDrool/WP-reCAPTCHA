msgstr "Bare gjeldende hvis har valgt å ha en separat feilsøkingslogg."

#: src/Admin/Settings.php:1044
msgid "Debug log's minimum level"
msgstr "Feilsøkingsloggens minstenivå"

#: src/Admin/Settings.php:1049
